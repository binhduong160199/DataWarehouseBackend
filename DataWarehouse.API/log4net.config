<?xml version="1.0" encoding="utf-8"?>
<log4net>
    <root>
        <level value="ALL" />
        <appender-ref ref="console" />
        <appender-ref ref="all_logs_rolling" />
        <appender-ref ref="important_logs_rolling" />
    </root>

    <!-- Console to Docker logs -->
    <appender name="console" type="log4net.Appender.ConsoleAppender">
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%date %-5level %logger - %message%newline" />
        </layout>
    </appender>

    <!-- All logs with size-based rotation -->
    <appender name="all_logs_rolling" type="log4net.Appender.RollingFileAppender">
        <file value="/app/logs/all.log" />
        <appendToFile value="true" />
        <rollingStyle value="Size" />
        <maximumFileSize value="10MB" />
        <maxSizeRollBackups value="5" />
        <preserveLogFileNameExtension value="true" />
        <staticLogFileName value="true" />
        <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%date %-5level %logger - %message%newline" />
        </layout>
    </appender>

    <!-- Important logs (WARN+) as JSON with size-based rotation -->
    <appender name="important_logs_rolling" type="log4net.Appender.RollingFileAppender">
        <file value="/app/logs/important.log" />
        <appendToFile value="true" />
        <rollingStyle value="Size" />
        <maximumFileSize value="10MB" />
        <maxSizeRollBackups value="10" />
        <preserveLogFileNameExtension value="true" />
        <staticLogFileName value="true" />
        <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
        <filter type="log4net.Filter.LevelRangeFilter">
            <param name="LevelMin" value="WARN" />
        </filter>
        <!-- Requires the log4net.Ext.Json package -->
        <layout type="log4net.Layout.SerializedLayout, log4net.Ext.Json">
            <decorator type="log4net.Layout.Decorators.StandardTypesDecorator, log4net.Ext.Json" />
            <member value="date:date" />
            <member value="level:level" />
            <member value="logger:logger" />
            <member value="message:messageObject" />
            <member value="exception:exception" />
        </layout>
    </appender>
</log4net>